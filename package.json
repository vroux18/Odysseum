{
  "name": "odysseum",
  "version": "0.1.0",
  "private": true,
  "description": "Odysseum : un archipel de casse-têtes calmes pour Android",
  "scripts": {
    "serve": "py -m http.server 8765 --directory www",
    "artifact": "py tools/build_artifact.py",
    "android:sync": "npx cap sync android",
    "android:open": "npx cap open android",
    "android:apk": "npx cap sync android && cd android && gradlew assembleDebug"
  },
  "dependencies": {
    "@capacitor/android": "^7.0.0",
    "@capacitor/core": "^7.0.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.0.0"
  }
}
